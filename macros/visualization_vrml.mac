/vis/open VRML2FILE
/vis/drawVolume
/vis/scene/add/axes 0 0 0 0.22 m
/vis/scene/add/trajectories smooth
/vis/scene/endOfEventAction accumulate

/vis/geometry/set/visibility World 0 false   
/vis/geometry/set/visibility TelescopeWorld 0 false   
/vis/geometry/set/visibility InnerVolume 0 false
/vis/geometry/set/visibility TopPanelBox 0 false
/vis/geometry/set/visibility BottomPanelBox 0 false


/vis/viewer/flush
