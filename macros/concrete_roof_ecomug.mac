# EcoMug reference run with the concrete roof in place
/run/initialize

# Geometry: roof deliberately close to the telescope (upper limit test)
/detector/roof          true
/detector/roofThickness 30 cm
/detector/roofHeight    1.6 m
/detector/roofHalfSize  1 m


/detector/lead          true
/detector/leadThickness 10 cm
/detector/leadGap       10 cm

/detector/rebuild

# EcoMug: generation plane just above the roof
/muonSource/ecomug/surface   sky
/muonSource/ecomug/skySizeX  2 m
/muonSource/ecomug/skySizeY  2 m
/muonSource/ecomug/skyCenter 0 0 2.0 m
/muonSource/ecomug/minMomentum 0.1 GeV
/muonSource/ecomug/maxMomentum 1000 GeV

/run/beamOn 1000000